# =============================================================================
# API
# =============================================================================
# Base URL of the backend API (backend-oosri).
# Must NOT have a trailing slash.
NEXT_PUBLIC_BASE_URL=http://localhost:5000

# =============================================================================
# AUTH
# =============================================================================
# Google OAuth client ID (used for Google Sign-In on the buyer app).
# Obtain from https://console.cloud.google.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your-google-client-id>

# =============================================================================
# PAYMENTS
# =============================================================================
# Stripe publishable key (safe to expose to the browser).
# Use sk_test_* for development, sk_live_* for production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-stripe-publishable-key>

# =============================================================================
# MAPS
# =============================================================================
# Google Maps JavaScript API key (used for address autocomplete).
# Restrict this key to your domain in the Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>

# =============================================================================
# SITE
# =============================================================================
# Public URL of this app (used for absolute URL generation, OG tags, etc.)
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
